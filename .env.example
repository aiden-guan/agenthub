# agenthub Environment Configuration Example
# Copy this file to .env or export these variables in your shell environment

# --- Hub Server Connection ---
# URL of the coordination hub server (default: http://127.0.0.1:7077)
HUB_URL=http://127.0.0.1:7077

# Optional shared bearer token if hub-server was started with --token
# HUB_TOKEN=your_shared_bearer_token_here

# --- Agent Identity ---
# Explicit agent identity override for this shell (e.g. maya/claude-1, sam/cursor-1)
# Takes precedence over the per-worktree identity recorded in .hub.json
# HUB_AGENT=maya/claude-1

# --- Security & Failure Modes ---
# Set to 1 to fail closed: deny edits and commits when the hub is unreachable
# Default behavior (0 / unset) fails open with a warning message
HUB_FAIL_CLOSED=0

# Set to 'off' to temporarily bypass git pre-commit / rebase guards during emergencies
# HUB_GUARD=off
